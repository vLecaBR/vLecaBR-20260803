        },
        {
          "name": "Inativar Usuario (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/usuarios/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", ":id"],
              "variable": [ { "key": "id", "value": "00000000-0000-0000-0000-000000000000" } ]
