# ==========================================================================
#  Monorepo — Sistema de Gestão de Colaboradores e Unidades
#  backend/  → API .NET 8   |   frontend/  → SPA Angular
# ==========================================================================

# --------------------------------------------------------------------------
#  Backend .NET (backend/)
# --------------------------------------------------------------------------
backend/**/bin/
backend/**/obj/
backend/**/out/
backend/**/publish/
backend/**/artifacts/

# IDEs / editores (Visual Studio, Rider, VS Code)
.vs/
.idea/
.vscode/
*.user
*.userosscache
*.suo
*.sln.docstates
_ReSharper*/
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg

# Resultados de teste / cobertura
[Tt]est[Rr]esult*/
TestResults/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# --------------------------------------------------------------------------
#  Frontend Angular (frontend/)
# --------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/out-tsc/
frontend/tmp/
frontend/*.tsbuildinfo

# Logs de npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/.npm/
frontend/.pnpm-store/

# --------------------------------------------------------------------------
#  Ambiente e segredos
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
**/appsettings.*.local.json
secrets.json

# --------------------------------------------------------------------------
#  Sistemas operacionais
# --------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*~

# Logs gerais
*.log

docs